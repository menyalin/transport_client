FROM node:22-alpine AS build
WORKDIR /app

ENV VUE_APP_API_URL=https://carrier.logicore.ru/api
ENV VUE_APP_API_WS_URL=https://carrier.logicore.ru
ENV VUE_APP_STATIC_URL=https://carrier.logicore.ru

ENV VITE_API_URL=https://carrier.logicore.ru/api
ENV VITE_API_WS_URL=https://carrier.logicore.ru
ENV VITE_STATIC_URL=https://carrier.logicore.ru

COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:stable-alpine
COPY alfa.nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
